// Repository-owned Hagia profile for the diagnostic comparison.
schema 1

policy {
  layout "scroller"
  layout-cycle "scroller"
  view-count 1
  outer-gap 0
  inner-gap 0
}

shell {
  enabled #true
  panel 28
}

shortcut {
  profile "desktop-comparison"
  bind "Ctrl+Alt+Delete" "session:logout"
  bind "Super+Return" "session:spawn-terminal"
  bind "Super+q" "session:close-window"
  bind "Super+t" "policy:toggle-floating"
}

session {
  terminal "terminal"
  browser "browser"
}

input { inherit-sophia #true; }
output { inherit-sophia #true; }
broker { enabled #false; }

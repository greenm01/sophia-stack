// Repository-owned niri 26.04 profile for the diagnostic comparison.
hotkey-overlay {
    skip-at-startup
}

output "DP-1" {
    mode "2560x1440@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-2" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=2560 y=0
}

animations {
    off
}

window-rule {
    match app-id=r#"^sophia-desktop-comparison$"#
    open-floating true
}

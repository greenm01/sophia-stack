(set-option :produce-models true)
(set-logic QF_LIA)

(declare-const x1 Int)
(declare-const y1 Int)
(declare-const w1 Int)
(declare-const h1 Int)
(declare-const x2 Int)
(declare-const y2 Int)
(declare-const w2 Int)
(declare-const h2 Int)
(declare-const rootw Int)
(declare-const rooth Int)

(define-fun overlap-x () Bool
  (and (< x1 (+ x2 w2)) (< x2 (+ x1 w1))))

;; Exact two-output instance of output_topology_from_engine_outputs: positive
;; logical sizes, one horizontal sequence, and root bounds equal to its union.
(define-fun secure-topology () Bool
  (and (= x1 0) (= y1 0)
       (> w1 0) (> h1 0)
       (= x2 (+ x1 w1)) (= y2 0)
       (> w2 0) (> h2 0)
       (= rootw (+ x2 w2))
       (= rooth (ite (> h1 h2) h1 h2))
       (> rootw 0) (> rooth 0)
       (<= rootw 65535) (<= rooth 65535)))

(echo "secure_outputs_do_not_overlap")
(push)
(assert secure-topology)
(assert overlap-x)
(check-sat)
(pop)

(echo "secure_outputs_are_contiguous")
(push)
(assert secure-topology)
(assert (not (= x2 (+ x1 w1))))
(check-sat)
(pop)

(echo "secure_root_is_exact_union")
(push)
(assert secure-topology)
(assert (or (not (= rootw (+ x2 w2)))
            (not (= rooth (ite (> h1 h2) h1 h2)))))
(check-sat)
(pop)

(echo "secure_root_bounds_do_not_overflow")
(push)
(assert secure-topology)
(assert (or (> rootw 65535) (> rooth 65535)))
(check-sat)
(pop)

(echo "negative_gapped_outputs")
(push)
(assert (= x1 0))
(assert (= y1 0))
(assert (> w1 0))
(assert (> h1 0))
(assert (> x2 (+ x1 w1)))
(assert (= y2 0))
(assert (> w2 0))
(assert (> h2 0))
(assert (= rootw (+ x2 w2)))
(assert (> rooth 0))
(check-sat)
(pop)

(echo "negative_partial_root")
(push)
(assert (= x1 0))
(assert (> w1 0))
(assert (= x2 (+ x1 w1)))
(assert (> w2 0))
(assert (= rootw (+ x1 w1)))
(check-sat)
(pop)

(echo "negative_zero_sized_output")
(push)
(assert (= w1 0))
(assert (> h1 0))
(assert (> w2 0))
(assert (> h2 0))
(check-sat)
(pop)

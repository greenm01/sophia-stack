(set-option :produce-models true)
(set-logic QF_NIA)
(include "validation/architecture/generated/sophia-wm-v1-facts.smt2")

(define-fun ipc_header_bytes () Int 24)
(define-fun ipc_max_payload_bytes () Int 65536)
(define-fun u16_max () Int 65535)
(define-fun u32_max () Int 4294967295)
(define-fun u64_max () Int 18446744073709551615)

(declare-const item_count Int)
(declare-const data_len Int)
(declare-const vulnerable_data_max Int)

(echo "secure_all_message_payload_bounds")
(push)
(assert (not (and
  (<= client_hello_max_payload_bytes ipc_max_payload_bytes)
  (<= server_welcome_max_payload_bytes ipc_max_payload_bytes)
  (<= snapshot_begin_max_payload_bytes ipc_max_payload_bytes)
  (<= snapshot_chunk_max_payload_bytes ipc_max_payload_bytes)
  (<= snapshot_end_max_payload_bytes ipc_max_payload_bytes)
  (<= projection_request_max_payload_bytes ipc_max_payload_bytes)
  (<= projection_begin_max_payload_bytes ipc_max_payload_bytes)
  (<= projection_chunk_max_payload_bytes ipc_max_payload_bytes)
  (<= projection_end_max_payload_bytes ipc_max_payload_bytes)
  (<= projection_outcome_max_payload_bytes ipc_max_payload_bytes)
  (<= policy_configuration_max_payload_bytes ipc_max_payload_bytes)
  (<= policy_configuration_outcome_max_payload_bytes ipc_max_payload_bytes)
  (<= policy_dirty_max_payload_bytes ipc_max_payload_bytes)
  (<= session_operation_request_max_payload_bytes ipc_max_payload_bytes)
  (<= session_operation_outcome_max_payload_bytes ipc_max_payload_bytes))))
(check-sat)
(pop)

(echo "secure_chunk_prefix_is_accounted")
(push)
(assert (or
  (not (= snapshot_chunk_max_payload_bytes
          (+ snapshot_chunk_fixed_payload_bytes snapshot_chunk_variable_payload_max)))
  (not (= projection_chunk_max_payload_bytes
          (+ projection_chunk_fixed_payload_bytes projection_chunk_variable_payload_max)))
  (> snapshot_chunk_max_payload_bytes ipc_max_payload_bytes)
  (> projection_chunk_max_payload_bytes ipc_max_payload_bytes)))
(check-sat)
(pop)

(echo "secure_schema_counts_are_field_representable")
(push)
(assert (not (and
  (<= wm_v1_max_outputs u16_max)
  (<= wm_v1_max_bindings u16_max)
  (<= wm_v1_max_surfaces u32_max)
  (= snapshot_chunk_field_item_count_width 4)
  (= projection_chunk_field_item_count_width 4))))
(check-sat)
(pop)

(echo "secure_record_products_fit_u64")
(push)
(assert (not (and
  (<= (* snapshot_output_record_max snapshot_output_record_width) u64_max)
  (<= (* snapshot_surface_record_max snapshot_surface_record_width) u64_max)
  (<= (* snapshot_binding_record_max snapshot_binding_record_width) u64_max)
  (<= (* snapshot_session_operation_record_max snapshot_session_operation_record_width) u64_max)
  (<= (* projection_output_record_max projection_output_record_width) u64_max)
  (<= (* projection_placement_record_max projection_placement_record_width) u64_max)
  (<= (* projection_indicator_record_max projection_indicator_record_width) u64_max)
  (<= (* projection_output_status_record_max projection_output_status_record_width) u64_max))))
(check-sat)
(pop)

(echo "secure_exact_chunk_length_bounds_product")
(push)
(assert (>= item_count 0))
(assert (<= item_count u32_max))
(assert (>= data_len 0))
(assert (<= data_len snapshot_chunk_variable_payload_max))
(assert (= data_len (* item_count snapshot_surface_record_width)))
(assert (or (> (* item_count snapshot_surface_record_width)
               snapshot_chunk_variable_payload_max)
            (> (* item_count snapshot_surface_record_width) u64_max)))
(check-sat)
(pop)

(echo "negative_omitted_chunk_prefix")
(push)
(assert (= vulnerable_data_max ipc_max_payload_bytes))
(assert (<= vulnerable_data_max ipc_max_payload_bytes))
(assert (> (+ snapshot_chunk_fixed_payload_bytes vulnerable_data_max)
           ipc_max_payload_bytes))
(check-sat)
(pop)

(echo "negative_unchecked_u32_record_product")
(push)
(assert (= item_count u32_max))
(assert (> (* item_count snapshot_surface_record_width) u32_max))
(check-sat)
(pop)

(echo "negative_record_max_used_as_chunk_count")
(push)
(assert (= item_count snapshot_surface_record_max))
(assert (> (* item_count snapshot_surface_record_width)
           snapshot_chunk_variable_payload_max))
(check-sat)
(pop)

(echo "negative_variable_field_ignores_fixed_prefix")
(push)
(assert (= vulnerable_data_max ipc_max_payload_bytes))
(assert (> (+ projection_request_fixed_payload_bytes vulnerable_data_max)
           ipc_max_payload_bytes))
(check-sat)
(pop)

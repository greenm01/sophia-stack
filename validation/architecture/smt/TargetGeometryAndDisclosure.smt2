(set-option :produce-models true)
(set-logic QF_NIA)

(define-fun max2 ((left Int) (right Int)) Int (ite (> left right) left right))
(define-fun min2 ((left Int) (right Int)) Int (ite (< left right) left right))

(declare-const allocation_left Int)
(declare-const allocation_right Int)
(declare-const target_left Int)
(declare-const target_right Int)
(declare-const grant_left Int)
(declare-const grant_right Int)
(declare-const point Int)
(declare-const disclosed Int)
(declare-const quantum Int)
(declare-const samples Int)
(declare-const emitted Int)
(declare-const rate_quota Int)
(declare-const first_frame_emitted Int)
(declare-const second_frame_emitted Int)
(declare-const target_count Int)
(declare-const target_quota Int)
(declare-const coordinate_cells Int)
(declare-const granted_cell_quota Int)
(declare-const distinguishable_outcomes Int)

(echo "secure_target_containment")
(push)
(assert (< allocation_left allocation_right))
(assert (<= allocation_left target_left))
(assert (< target_left target_right))
(assert (<= target_right allocation_right))
(assert (or (< target_left allocation_left) (> target_right allocation_right)))
(check-sat)
(pop)

(echo "secure_region_clipping")
(push)
(assert (< target_left target_right))
(assert (< grant_left grant_right))
(assert (= disclosed point))
(assert (<= (max2 target_left grant_left) point))
(assert (< point (min2 target_right grant_right)))
(assert (or (< disclosed target_left) (>= disclosed target_right)
            (< disclosed grant_left) (>= disclosed grant_right)))
(check-sat)
(pop)

(echo "secure_quantization")
(push)
(assert (> quantum 0))
(assert (<= grant_left point))
(assert (= disclosed
  (+ grant_left (* (div (- point grant_left) quantum) quantum))))
(assert (not (= (mod (- disclosed grant_left) quantum) 0)))
(check-sat)
(pop)

(echo "secure_capability_epoch_rate_quota")
(push)
(assert (>= samples 0))
(assert (>= emitted 0))
(assert (>= rate_quota 0))
(assert (<= emitted samples))
(assert (<= emitted rate_quota))
(assert (> emitted rate_quota))
(check-sat)
(pop)

(echo "secure_bounded_distinguishable_outcomes")
(push)
(assert (and (>= target_count 0) (<= target_count target_quota)))
(assert (and (>= coordinate_cells 0) (<= coordinate_cells granted_cell_quota)))
(assert (<= distinguishable_outcomes (+ target_count coordinate_cells)))
(assert (> distinguishable_outcomes (+ target_quota granted_cell_quota)))
(check-sat)
(pop)

(echo "negative_target_outside_allocation")
(push)
(assert (= allocation_left 0))
(assert (= allocation_right 100))
(assert (= target_left (- 1)))
(assert (= target_right 10))
(assert (or (< target_left allocation_left) (> target_right allocation_right)))
(check-sat)
(pop)

(echo "negative_unclipped_coordinate")
(push)
(assert (= target_left 10))
(assert (= target_right 20))
(assert (= grant_left 0))
(assert (= grant_right 30))
(assert (= point 5))
(assert (and (<= grant_left point) (< point grant_right)))
(assert (or (< point target_left) (>= point target_right)))
(check-sat)
(pop)

(echo "negative_unquantized_coordinate")
(push)
(assert (= grant_left 0))
(assert (= quantum 8))
(assert (= point 5))
(assert (= disclosed point))
(assert (not (= (mod (- disclosed grant_left) quantum) 0)))
(check-sat)
(pop)

(echo "negative_frame_local_rate_reset")
(push)
(assert (= rate_quota 4))
(assert (= first_frame_emitted 4))
(assert (= second_frame_emitted 4))
(assert (<= first_frame_emitted rate_quota))
(assert (<= second_frame_emitted rate_quota))
(assert (> (+ first_frame_emitted second_frame_emitted) rate_quota))
(check-sat)
(pop)

(echo "negative_unbounded_target_partition")
(push)
(assert (= target_quota 8))
(assert (= target_count 9))
(assert (> target_count target_quota))
(check-sat)
(pop)

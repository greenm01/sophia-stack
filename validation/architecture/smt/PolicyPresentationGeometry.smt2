(set-option :produce-models true)
(set-logic QF_LIA)

(declare-const bx Int)
(declare-const by Int)
(declare-const bw Int)
(declare-const bh Int)
(declare-const wx Int)
(declare-const wy Int)
(declare-const ww Int)
(declare-const wh Int)
(declare-const gx Int)
(declare-const gy Int)
(declare-const gw Int)
(declare-const gh Int)
(declare-const state Int)
(declare-const focused Bool)

(define-fun contains ((ox Int) (oy Int) (ow Int) (oh Int)
                      (ix Int) (iy Int) (iw Int) (ih Int)) Bool
  (and (> ow 0) (> oh 0) (> iw 0) (> ih 0)
       (>= ix ox) (>= iy oy)
       (<= (+ ix iw) (+ ox ow))
       (<= (+ iy ih) (+ oy oh))))

(define-fun base () Bool
  (and (contains bx by bw bh wx wy ww wh)
       (>= state 0) (<= state 3)))

(define-fun secure () Bool
  (and base
       (=> (= state 1)
           (and (= gx bx) (= gy by) (= gw bw) (= gh bh)))
       (=> (not (= state 1))
           (contains wx wy ww wh gx gy gw gh))
       (=> (= state 3) (not focused))))

(echo "secure_fullscreen_is_exact_output")
(push)
(assert secure)
(assert (= state 1))
(assert (not (and (= gx bx) (= gy by) (= gw bw) (= gh bh))))
(check-sat)
(pop)

(echo "secure_nonfullscreen_stays_in_work_area")
(push)
(assert secure)
(assert (not (= state 1)))
(assert (not (contains wx wy ww wh gx gy gw gh)))
(check-sat)
(pop)

(echo "secure_minimized_cannot_be_focused")
(push)
(assert secure)
(assert (= state 3))
(assert focused)
(check-sat)
(pop)

(echo "negative_normal_geometry_uses_output_bounds")
(push)
(assert base)
(assert (= state 0))
(assert (contains bx by bw bh gx gy gw gh))
(assert (not (contains wx wy ww wh gx gy gw gh)))
(check-sat)
(pop)

(echo "negative_fullscreen_is_only_contained")
(push)
(assert base)
(assert (= state 1))
(assert (contains bx by bw bh gx gy gw gh))
(assert (not (and (= gx bx) (= gy by) (= gw bw) (= gh bh))))
(check-sat)
(pop)

(echo "negative_minimized_focus")
(push)
(assert base)
(assert (= state 3))
(assert focused)
(check-sat)
(pop)

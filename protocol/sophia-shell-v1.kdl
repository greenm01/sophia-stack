protocol "sophia_shell_v1" frame-version=1 interface-major=1 interface-revision=4 max-descriptors=16 max-label-bytes=128 max-pending-activations=16 max-shortcuts=256 {
    capability "descriptor_switcher" bit=0
    capability "work_area_reservation" bit=1
    capability "tab_groups" bit=2 since=2
    capability "shortcut_catalog" bit=3 since=3
    capability "reference_sheet" bit=4 since=3
    capability "application_catalog" bit=5 since=4
    capability "application_launcher" bit=6 since=4 requires="application_catalog"

    outcome "prepared" value=1
    outcome "presented" value=2
    outcome "rejected" value=3
    outcome "superseded" value=4

    activation-disposition "consumed" value=1
    activation-disposition "rejected_stale" value=2

    // Every action is issued for one broker epoch, revoked as a class by one
    // broker revocation epoch, narrowed to one shell connection, and bound to
    // one opaque descriptor slot and generation. Surface ids never cross.
    record "ToplevelActionCapability" {
        field "token" type="u64"
        field "issuer_epoch" type="u64"
        field "issuer_revocation_epoch" type="u64"
        field "recipient_epoch" type="u64"
        field "target_slot" type="u16"
        field "reserved" type="u16" reserved=#true
        field "target_generation" type="u64"
    }

    message "ClientHello" kind=96 direction="shell-to-session" transaction="zero" {
        field "minimum_revision" type="u16"
        field "maximum_revision" type="u16"
        field "required_capabilities" type="u64"
    }
    message "ServerWelcome" kind=97 direction="session-to-shell" transaction="zero" {
        field "selected_revision" type="u16"
        field "reserved" type="u16" reserved=#true
        field "connection_epoch" type="u64"
        field "capabilities" type="u64"
        field "max_descriptors" type="u16"
        field "max_label_bytes" type="u16"
        field "max_pending_activations" type="u16"
        field "trailing_reserved" type="u16" reserved=#true
    }
    message "DescriptorSnapshot" kind=98 direction="session-to-shell" transaction="required" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "output" type="opaque-u64"
        field "output_generation" type="u64"
        field "broker_epoch" type="u64"
        field "broker_revocation_epoch" type="u64"
        field "descriptor_count" type="u16" max=16
        field "reserved" type="u16" reserved=#true
        repeated "descriptor" count="descriptor_count" {
            field "slot" type="u16"
            field "trust_level" type="u8"
            field "attention" type="u8"
            field "generation" type="u64"
            record-ref "action" record="ToplevelActionCapability"
            field "label_present" type="bool-u8"
            field "label_len" type="u16" max=128
            field "label" type="utf8" length="label_len"
            field "label_redacted" type="bool-u8" present-if="label_present"
        }
    }
    message "Candidate" kind=99 direction="shell-to-session" transaction="required" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "candidate_generation" type="u64"
        field "output" type="opaque-u64"
        field "visible" type="bool-u8"
        field "reservation_edge" type="u8" zero="none" max=4
        field "selected_slot" type="u16" zero="none"
        field "entry_count" type="u16" max=16
        field "reservation_thickness" type="u16" zero="none" max=512
        repeated "entry" count="entry_count" {
            field "slot" type="u16"
            field "reserved" type="u16" reserved=#true
            field "generation" type="u64"
        }
    }
    message "CandidateOutcome" kind=100 direction="session-to-shell" transaction="required" {
        field "connection_epoch" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64" zero="unless-presented"
        field "outcome" type="u16"
        field "reserved" type="u16" reserved=#true
    }
    message "Activation" kind=101 direction="session-to-shell" transaction="required" {
        field "connection_epoch" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "activation" type="u64"
        record-ref "action" record="ToplevelActionCapability"
    }
    message "ActivationAck" kind=102 direction="shell-to-session" transaction="required" {
        field "connection_epoch" type="u64"
        field "activation" type="u64"
        field "disposition" type="u16"
        field "reserved" type="u16" reserved=#true
    }

    // Revision 2 only, capability tab_groups. Begin/group/entry/end share one
    // transaction and epoch/generation. A candidate confirms the exact group
    // order; membership, selected member and geometry remain committed WM facts.
    message "TabsBegin" kind=103 direction="session-to-shell" transaction="required" since=2 gate="tab_groups" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "group_count" type="u16"
        field "entry_count" type="u16"
    }
    message "TabsGroup" kind=104 direction="session-to-shell" transaction="required" since=2 gate="tab_groups" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "group_slot" type="opaque-u64"
        field "output" type="opaque-u64"
        field "selected_slot" type="u16"
        field "focused" type="bool-u16"
        field "entry_count" type="u16"
        field "reserved" type="u16" reserved=#true
    }
    message "TabsEntry" kind=105 direction="session-to-shell" transaction="required" since=2 gate="tab_groups" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "group_slot" type="opaque-u64"
        field "descriptor_snapshot" type="descriptor-snapshot-payload-single-entry"
    }
    message "TabsEnd" kind=106 direction="session-to-shell" transaction="required" since=2 gate="tab_groups" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
    }
    message "TabsCandidate" kind=107 direction="shell-to-session" transaction="required" since=2 gate="tab_groups" {
        field "connection_epoch" type="u64"
        field "snapshot_generation" type="u64"
        field "candidate_generation" type="u64"
        field "group_count" type="u16"
        field "reserved" type="u16" reserved=#true
        field "groups" type="opaque-u64-array"
    }

    // Revision 3 is read-only. Slots identify catalog rows, never actions.
    // Text is UTF-8, length-prefixed u16 bytes, without controls or bidi overrides.
    // A complete catalog transfer is atomic and contains at most 256 rows.
    message "ShortcutsBegin" kind=108 direction="session-to-shell" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "entry_count" type="u16" max=256
        field "reserved" type="u16" reserved=#true
    }
    message "ShortcutsEntry" kind=109 direction="session-to-shell" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "slot" type="u16"
        field "reserved" type="u16" reserved=#true
        field "chord_length" type="u16" max=64
        field "chord" type="bytes" length="chord_length"
        field "action_length" type="u16" max=128
        field "action" type="bytes" length="action_length"
        field "label_length" type="u16" max=128
        field "label" type="bytes" length="label_length"
        field "group_length" type="u16" max=64
        field "group" type="bytes" length="group_length"
    }
    message "ShortcutsEnd" kind=110 direction="session-to-shell" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
    }
    message "ReferenceRequest" kind=111 direction="session-to-shell" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "output" type="u64"
        field "output_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "operation" type="u16" max=4
        field "reserved" type="u16" reserved=#true
    }
    message "ReferenceCandidate" kind=112 direction="shell-to-session" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "output" type="u64"
        field "visible" type="u16" max=1
        field "page" type="u16"
        field "entry_count" type="u16" max=256
        field "reserved" type="u16" reserved=#true
        field "body_size" type="u16" max=32
        field "title_size" type="u16" max=48
        field "padding" type="u16" max=64
        field "row_gap" type="u16" max=32
        field "key_gap" type="u16" max=64
        field "column_gap" type="u16" max=64
        field "border" type="u16" max=16
        field "margin" type="u16" max=128
        field "columns" type="u16" max=4
        field "background_argb" type="u32"
        field "border_argb" type="u32"
        field "key_text_argb" type="u32"
        field "label_text_argb" type="u32"
        field "key_background_argb" type="u32"
        field "title_text_argb" type="u32"
        field "title_length" type="u16" max=128
        field "title" type="bytes" length="title_length"
        repeated "entry" count="entry_count" {
        field "slot" type="u16"
        field "entry_reserved" type="u16" reserved=#true
        field "key_length" type="u16" max=64
        field "key" type="bytes" length="key_length"
        field "label_length" type="u16" max=128
        field "label" type="bytes" length="label_length"
        }
    }
    message "ReferenceOutcome" kind=113 direction="session-to-shell" transaction="required" since=3 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "page" type="u16"
        field "pages" type="u16"
        field "outcome" type="u16"
        field "reserved" type="u16" reserved=#true
    }

    // Revision 4 catalog slots are display references, never launch grants.
    // See docs/application-launcher.md for state, bounds and revocation rules.
    message "ApplicationsBegin" kind=114 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "entry_count" type="u16"
        field "reserved" type="u16" reserved=#true
    }
    message "ApplicationsEntry" kind=115 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "slot" type="u16"
        field "available" type="u16"
        field "label" type="string-u16"
        field "keywords" type="string-u16"
    }
    message "ApplicationsEnd" kind=116 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
    }
    message "LauncherRequest" kind=117 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "output" type="u64"
        field "output_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "operation" type="u16"
        field "reserved" type="u16" reserved=#true
        field "query" type="string-u16"
    }
    message "LauncherCandidate" kind=118 direction="shell-to-session" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "output" type="u64"
        field "visible" type="u16"
        field "selected" type="u16"
        field "entry_count" type="u16"
        field "font_size" type="u16"
        field "colors" type="u32[4]"
        field "entries" type="u16[entry_count]"
    }
    message "LauncherOutcome" kind=119 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "kind" type="u16"
        field "reserved" type="u16" reserved=#true
    }
    message "LauncherActivation" kind=120 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "activation" type="u64"
        field "slot" type="u16"
        field "reserved" type="u16" reserved=#true
    }
    message "LauncherActivationAck" kind=121 direction="shell-to-session" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "activation" type="u64"
        field "slot" type="u16"
        field "consumed" type="u16"
    }
    message "LaunchOutcome" kind=122 direction="session-to-shell" transaction="required" since=4 {
        field "connection_epoch" type="u64"
        field "catalog_generation" type="u64"
        field "request_generation" type="u64"
        field "candidate_generation" type="u64"
        field "presentation_epoch" type="u64"
        field "activation" type="u64"
        field "slot" type="u16"
        field "status" type="u16"
    }
}

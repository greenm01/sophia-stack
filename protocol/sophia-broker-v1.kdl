protocol "sophia_broker_v1" frame-version=1 interface-major=1 interface-revision=1 max-surfaces=1024 max-label-bytes=128 {
    // Kinds 80-83 use the common 24-byte Sophia envelope. Request and response
    // bodies begin with a strict u16 tagged-union discriminant, a reserved zero
    // u16, and the u64 connection epoch selected by ServerWelcome.
    message "ClientHello" kind=80 direction="broker-to-session" transaction="zero" {
        field "minimum_revision" type="u16" sample=1
        field "maximum_revision" type="u16" sample=1
    }
    message "ServerWelcome" kind=81 direction="session-to-broker" transaction="zero" {
        field "selected_revision" type="u16" sample=1
        field "reserved" type="u16" reserved=#true sample=0
        field "connection_epoch" type="u64" sample=9
        field "max_surfaces" type="u32" sample=1024
        field "max_label_bytes" type="u16" sample=128
        field "trailing_reserved" type="u16" reserved=#true sample=0
    }
    message "Request" kind=82 direction="session-to-broker" transaction="required" {
        field "request_kind" type="u16" sample=1
        field "reserved" type="u16" reserved=#true sample=0
        field "connection_epoch" type="u64" sample=9
        field "body" type="tagged-bytes" max=160 sample=""
    }
    message "Response" kind=83 direction="broker-to-session" transaction="required" {
        field "response_kind" type="u16" sample=1
        field "reserved" type="u16" reserved=#true sample=0
        field "connection_epoch" type="u64" sample=9
        field "body" type="tagged-bytes" max=160 sample=""
    }

    request-kind "surface_admitted" value=1
    request-kind "candidate_reduced" value=2
    request-kind "attention_changed" value=3
    request-kind "surface_removed" value=4
    request-kind "set_disclosure" value=5
    response-kind "publish_rule" value=1
    response-kind "emit_descriptor" value=2
    response-kind "retire_surface" value=3
    response-kind "rejected" value=4
    response-kind "no_change" value=5
}

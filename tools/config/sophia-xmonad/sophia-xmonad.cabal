cabal-version: 3.0
name: sophia-xmonad
version: 0.1.0
build-type: Simple
license: BSD-3-Clause

executable sophia-xmonad
  main-is: Main.hs
  build-depends:
      base >=4.18 && <5
    , containers >=0.6 && <0.8
    , X11 >=1.10 && <1.11
    , xmonad ==0.18.1
    , xmonad-contrib ==0.18.2
  default-language: GHC2021
  ghc-options: -O2 -threaded -Wall

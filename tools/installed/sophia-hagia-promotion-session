#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

export SOPHIA_HAGIA_PROFILE_MODE=packaged-promotion
export SOPHIA_INSTALLED_ATTEMPT_MODE=hagia-promotion
unset SOPHIA_DESKTOP_PROFILE SOPHIA_DESKTOP_PROFILE_SHA256
exec "$RELEASE_DIR/bin/sophia-hagia-session" "$@"

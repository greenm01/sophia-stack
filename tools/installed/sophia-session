#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$RELEASE_DIR/tools/lib/session_lifecycle.sh"
export SOPHIA_TTY_PROFILE="${SOPHIA_TTY_PROFILE:?a native Sophia session profile is required}"
export SOPHIA_BUILD_SESSION=false
export SOPHIA_MANAGE_KEYD=false
export SOPHIA_INSTALLED_SESSION=true
export SOPHIA_REQUIRE_RUNTIME_DIR=true
export SOPHIA_REQUIRE_LOCAL_VT=true
export SOPHIA_BIN="$RELEASE_DIR/target/release/sophia"
export SOPHIA_NATIVE_WM_BIN="$RELEASE_DIR/target/release/sophia-wm-demo"
# The policy client is a blind client: it sees no pixels, holds no
# privileges, and every proposal it makes is validated by the Engine before
# anything is drawn. It does not need to be immutable the way the Engine does,
# so it lives where its owner can replace it, and `just reload-wm` swaps it
# while the desktop keeps running. `install-session` puts it there; the copy
# inside the release is the fallback for an install that never ran it, and is
# what the gates and the promotion session use.
sophia_user_wm="${XDG_STATE_HOME:-$HOME/.local/state}/sophia/bin/hagia"
if [[ -n "${SOPHIA_HAGIA_BIN:-}" ]]; then
    : # An explicit value wins, which is how the gates point at their fixtures.
elif [[ -x "$sophia_user_wm" ]]; then
    if [[ ! -O "$sophia_user_wm" ]]; then
        echo "sophia: refusing a policy client owned by another user: $sophia_user_wm" >&2
        exit 1
    fi
    if [[ "$(stat -c %A "$sophia_user_wm")" == *w*w* ]]; then
        echo "sophia: refusing a group- or world-writable policy client: $sophia_user_wm" >&2
        exit 1
    fi
    SOPHIA_HAGIA_BIN="$sophia_user_wm"
else
    SOPHIA_HAGIA_BIN="$RELEASE_DIR/target/release/hagia"
fi
export SOPHIA_HAGIA_BIN
export SOPHIA_HAGIA_SHELL_BIN="$RELEASE_DIR/target/release/narthex"
export SOPHIA_TTY_MODE_HELPER="$RELEASE_DIR/tools/sophia_tty_mode.py"

manifest="$RELEASE_DIR/manifest"
version="$(sed -n 's/^version=//p' "$manifest" | head -n 1)"
commit="$(sed -n 's/^commit=//p' "$manifest" | head -n 1)"
export SOPHIA_INSTALLED_VERSION="${version:-unknown}"
export SOPHIA_INSTALLED_COMMIT="${commit:-unknown}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sophia/installed-session"
install -d -m 700 "$state_dir"
identity_log="$state_dir/launch.log"
sophia_session_rotate_log "$identity_log"
runtime_identity_log="$state_dir/runtime-identity.log"
sophia_session_rotate_log "$runtime_identity_log"
launch_id="$(date -u +%Y%m%dT%H%M%S%NZ)"
profile_identity=""
if [[ "$SOPHIA_TTY_PROFILE" == hagia ]]; then
    profile_identity=" desktop_profile_mode=${SOPHIA_HAGIA_PROFILE_MODE:?} desktop_profile_sha256=${SOPHIA_DESKTOP_PROFILE_SHA256:?}"
fi
printf 'sophia_installed_session schema=1 status=starting profile=%s version=%s commit=%s release=%s started_at_utc=%s launch_id=%s%s\n' \
    "$SOPHIA_TTY_PROFILE" "${version:-unknown}" "${commit:-unknown}" "$RELEASE_DIR" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$launch_id" "$profile_identity" | tee "$identity_log"
chmod 600 "$identity_log"
"$RELEASE_DIR/bin/capture-runtime-identity" "$runtime_identity_log" "$RELEASE_DIR"

attempt_mode="${SOPHIA_INSTALLED_ATTEMPT_MODE:-$SOPHIA_TTY_PROFILE}"
attempt_dir=""
attempt_record=""
attempt_result_record=""
case "$attempt_mode" in
    firefox)
        attempt_record="$RELEASE_DIR/bin/sophia-record-firefox-attempt"
        attempt_result_record=sophia_installed_firefox
        ;;
    xterm)
        attempt_record="$RELEASE_DIR/bin/sophia-record-xterm-run"
        attempt_result_record=sophia_installed_xterm
        ;;
    truecolor)
        attempt_record="$RELEASE_DIR/bin/sophia-record-truecolor-run"
        attempt_result_record=sophia_installed_truecolor
        ;;
    kitty)
        attempt_record="$RELEASE_DIR/bin/sophia-record-fallback-run"
        attempt_result_record=sophia_installed_fallback
        ;;
    watchdog)
        attempt_record="$RELEASE_DIR/bin/sophia-record-watchdog-run"
        attempt_result_record=sophia_installed_watchdog
        ;;
    native-chrome)
        attempt_record="$RELEASE_DIR/bin/sophia-record-native-chrome-run"
        attempt_result_record=sophia_installed_native_chrome
        ;;
    hagia)
        attempt_record="$RELEASE_DIR/bin/sophia-record-hagia-run"
        attempt_result_record=sophia_installed_hagia
        ;;
    hagia-promotion)
        attempt_record="$RELEASE_DIR/bin/sophia-record-hagia-run"
        attempt_result_record=sophia_installed_hagia_promotion
        ;;
esac
# Reserve the ledger slot before takeover. A crash or interrupted handoff then
# remains a pending attempt and cannot disappear between later clean runs.
if [[ -n "$attempt_record" ]]; then
    if ! attempt_dir="$("$attempt_record" begin)"; then
        echo "$attempt_result_record schema=1 status=untracked phase=begin" >&2
        exit 1
    fi
fi

set +e
"$RELEASE_DIR/tools/run_sophia_session.sh" "$@"
session_status=$?
set -e
if [[ "$attempt_mode" =~ ^(hagia|firefox|xterm)$ && "$session_status" == 130 ]] &&
    ! "$RELEASE_DIR/bin/sophia-record-emergency-run"; then
    # The normal pending attempt still preserves the launch if archival fails.
    echo "sophia_installed_emergency schema=1 status=record_failed phase=finish session_exit_status=$session_status" >&2
fi
if [[ -n "$attempt_dir" ]] &&
    ! "$attempt_record" finish "$attempt_dir" "$session_status"; then
    # Evidence failure must not rewrite the session's real exit status.
    echo "$attempt_result_record schema=1 status=record_failed phase=finish session_exit_status=$session_status" >&2
fi
exit "$session_status"

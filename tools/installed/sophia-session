#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$RELEASE_DIR/tools/lib/session_lifecycle.sh"
export SOPHIA_TTY_PROFILE="${SOPHIA_TTY_PROFILE:-xmonad}"
export SOPHIA_BUILD_SESSION=false
export SOPHIA_MANAGE_KEYD=false
export SOPHIA_INSTALLED_SESSION=true
export SOPHIA_REQUIRE_RUNTIME_DIR=true
export SOPHIA_REQUIRE_LOCAL_VT=true
export SOPHIA_BIN="$RELEASE_DIR/target/release/sophia"
export SOPHIA_X11_WM_BRIDGE_BIN="$RELEASE_DIR/target/release/sophia-x11-wm-bridge"
export SOPHIA_XMONAD_BIN="$RELEASE_DIR/target/release/xmonad"
export SOPHIA_TTY_MODE_HELPER="$RELEASE_DIR/tools/sophia_tty_mode.py"

manifest="$RELEASE_DIR/manifest"
version="$(sed -n 's/^version=//p' "$manifest" | head -n 1)"
commit="$(sed -n 's/^commit=//p' "$manifest" | head -n 1)"
export SOPHIA_INSTALLED_VERSION="${version:-unknown}"
export SOPHIA_INSTALLED_COMMIT="${commit:-unknown}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sophia/installed-session"
install -d -m 700 "$state_dir"
identity_log="$state_dir/launch.log"
sophia_session_rotate_log "$identity_log"
runtime_identity_log="$state_dir/runtime-identity.log"
sophia_session_rotate_log "$runtime_identity_log"
launch_id="$(date -u +%Y%m%dT%H%M%S%NZ)"
printf 'sophia_installed_session schema=1 status=starting profile=%s version=%s commit=%s release=%s started_at_utc=%s launch_id=%s\n' \
    "$SOPHIA_TTY_PROFILE" "${version:-unknown}" "${commit:-unknown}" "$RELEASE_DIR" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$launch_id" | tee "$identity_log"
chmod 600 "$identity_log"
"$RELEASE_DIR/bin/capture-runtime-identity" "$runtime_identity_log" "$RELEASE_DIR"

attempt_mode="${SOPHIA_INSTALLED_ATTEMPT_MODE:-$SOPHIA_TTY_PROFILE}"
attempt_dir=""
attempt_record=""
attempt_result_record=""
case "$attempt_mode" in
    xmonad)
        attempt_record="$RELEASE_DIR/bin/sophia-record-run"
        attempt_result_record=sophia_installed_cycle
        ;;
    kitty)
        attempt_record="$RELEASE_DIR/bin/sophia-record-fallback-run"
        attempt_result_record=sophia_installed_fallback
        ;;
    watchdog)
        attempt_record="$RELEASE_DIR/bin/sophia-record-watchdog-run"
        attempt_result_record=sophia_installed_watchdog
        ;;
esac
# Reserve the ledger slot before takeover. A crash or interrupted handoff then
# remains a pending attempt and cannot disappear between later clean runs.
if [[ -n "$attempt_record" ]]; then
    if ! attempt_dir="$("$attempt_record" begin)"; then
        echo "$attempt_result_record schema=1 status=untracked phase=begin" >&2
        exit 1
    fi
fi

set +e
"$RELEASE_DIR/tools/run_sophia_xmonad_session.sh" "$@"
session_status=$?
set -e
if [[ "$attempt_mode" == xmonad && "$session_status" == 130 ]] &&
    ! "$RELEASE_DIR/bin/sophia-record-emergency-run"; then
    # The normal pending attempt still preserves the launch if archival fails.
    echo "sophia_installed_emergency schema=1 status=record_failed phase=finish session_exit_status=$session_status" >&2
fi
if [[ -n "$attempt_dir" ]] &&
    ! "$attempt_record" finish "$attempt_dir" "$session_status"; then
    # Evidence failure must not rewrite the session's real exit status.
    echo "$attempt_result_record schema=1 status=record_failed phase=finish session_exit_status=$session_status" >&2
fi
exit "$session_status"

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
if [[ -f "$SCRIPT_DIR/../lib/installed_soak_evidence.sh" ]]; then
    # Keep the checked-in command runnable against fixtures before packaging.
    source "$SCRIPT_DIR/../lib/installed_soak_evidence.sh"
else
    RELEASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    source "$RELEASE_DIR/tools/lib/installed_soak_evidence.sh"
fi

usage() {
    echo "usage: sophia-soak-progress [--watch]" >&2
    exit 1
}

watch=false
case "${1:-}" in
    "") (( $# == 0 )) || usage ;;
    --watch) (( $# == 1 )) || usage; watch=true ;;
    *) usage ;;
esac

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
session_log="${SOPHIA_SOAK_SESSION_LOG:-$state_home/sophia/xmonad-session/session.log}"
identity_log="${SOPHIA_SOAK_IDENTITY_LOG:-$state_home/sophia/installed-session/launch.log}"

show_progress() {
    [[ -f "$session_log" ]] || {
        echo "No Sophia xmonad session log is available yet: $session_log"
        return
    }
    local identity commit started started_epoch now elapsed completion elapsed_msec
    local terminal firefox close practical missing views moves pointer_moves pointer_resizes
    identity="$(tail -n 1 "$identity_log" 2>/dev/null || true)"
    commit=unknown
    started=""
    local token
    for token in $identity; do
        [[ "$token" != commit=* ]] || commit="${token#*=}"
        [[ "$token" != started_at_utc=* ]] || started="${token#*=}"
    done
    completion="$(sophia_soak_completion "$session_log" | tail -n 1)"
    elapsed_msec="$(sophia_soak_line_field "$completion" elapsed_msec 2>/dev/null || true)"
    if [[ "$elapsed_msec" =~ ^[0-9]+$ ]]; then
        elapsed=$((elapsed_msec / 1000))
    elif [[ -n "$started" ]] && started_epoch="$(date -d "$started" +%s 2>/dev/null)"; then
        now="$(date +%s)"
        elapsed=$((now > started_epoch ? now - started_epoch : 0))
    else
        elapsed=0
    fi
    terminal="$(sophia_soak_count "$session_log" '^sophia_session_app schema=(1|2) status=started id=terminal source=action( |$)')"
    firefox="$(sophia_soak_count "$session_log" '^sophia_session_app schema=(1|2) status=started id=firefox source=action( |$)')"
    close="$(sophia_soak_count "$session_log" '^sophia_live_wm schema=1 status=session_action_committed .* action=CloseFocused$')"
    practical="$(sophia_soak_practical_complete_count "$session_log")"
    missing="$(sophia_soak_missing_actions "$session_log")"
    views="$(sophia_soak_workspace_view_count "$session_log")"
    moves="$(sophia_soak_workspace_move_count "$session_log")"
    pointer_moves="$(sophia_soak_count "$session_log" '^sophia_live_wm schema=4 status=pointer_gesture_committed mode=move$')"
    pointer_resizes="$(sophia_soak_count "$session_log" '^sophia_live_wm schema=4 status=pointer_gesture_committed mode=resize$')"
    printf 'Sophia soak %s  elapsed %02d:%02d:%02d / 02:00:00\n' \
        "${commit:0:12}" "$((elapsed / 3600))" "$(((elapsed / 60) % 60))" "$((elapsed % 60))"
    printf 'Apps: Kitty %s/10  Firefox %s/5  close %s/15\n' "$terminal" "$firefox" "$close"
    printf 'Policy: %s/%s  remaining: %s\n' \
        "$practical" "${#SOPHIA_SOAK_PRACTICAL_ACTION_IDS[@]}" "$missing"
    printf 'Workspace: view %s  move %s    Pointer: move %s  resize %s\n' \
        "$views" "$moves" "$pointer_moves" "$pointer_resizes"
}

while true; do
    if [[ "$watch" == true ]]; then
        printf '\033[2J\033[H'
    fi
    show_progress
    [[ "$watch" == true ]] || break
    sleep 2
done

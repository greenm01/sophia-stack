Config { font = "DejaVu Sans Mono 10"
       , additionalFonts = []
       , borderColor = "black"
       , border = NoBorder
       , bgColor = "#111111"
       , fgColor = "#eeeeee"
       , alpha = 255
       , position = Top
       , lowerOnStart = False
       , pickBroadest = False
       , persistent = True
       , hideOnStart = False
       , allDesktops = True
       , overrideRedirect = True
       , textOutputFormat = Ansi
       , commands = [ Run Cpu ["-t", "CPU <total>%"] 1
                    , Run Memory ["-t", "MEM <usedratio>%"] 2
                    , Run Date "%H:%M:%S" "date" 5
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = " Sophia contention | %cpu% | %memory% }{ %date% "
       }
